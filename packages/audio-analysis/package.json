{
  "name": "@thumbline/audio-analysis",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@thumbline/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker": {
      "@thumbline/source": "./src/worker-entry.ts",
      "types": "./dist/worker-entry.d.ts",
      "import": "./dist/worker-entry.js",
      "default": "./dist/worker-entry.js"
    }
  },
  "dependencies": {
    "essentia.js": "0.1.3",
    "tslib": "^2.3.0"
  },
  "nx": {
    "tags": [
      "scope:audio-analysis",
      "type:core"
    ],
    "targets": {
      "eval": {
        "command": "node tools/make-synthetic-fixtures.mjs && node packages/audio-analysis/eval/eval.mjs",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "dependsOn": [
          "build",
          {
            "projects": [
              "@thumbline/engine",
              "@thumbline/playback"
            ],
            "target": "build"
          }
        ],
        "cache": false
      }
    }
  }
}
